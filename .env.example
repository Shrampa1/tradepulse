# --- Expo app (client-side, safe to expose — no secret keys here) ---
# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Note: there's no client-side payment key to set here. Safepay's checkout
# happens entirely on the public-quote web page via a server-generated
# redirect link — the Expo app never talks to Safepay directly.

# --- Everything below is set as Supabase Edge Function secrets, NOT bundled
# --- into the app. Set with:
#     supabase secrets set --env-file supabase/functions/.env
# (create supabase/functions/.env locally from supabase/functions/.env.example,
# it is gitignored and never shipped to the mobile app.)
