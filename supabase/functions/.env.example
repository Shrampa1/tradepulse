# Supabase Edge Function secrets (server-side only — never bundled into the app).
# Deploy with: supabase secrets set --env-file supabase/functions/.env

# Supabase (Project Settings -> API). Service role key bypasses RLS and is used
# only inside edge functions (public-quote, safepay-webhook) that must read/write
# data on behalf of an unauthenticated client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (audio + vision, parses voice notes/photos into line items)
# Get one at https://aistudio.google.com/apikey — real keys look like "AIzaSy...".
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.0-flash in the function.
GEMINI_MODEL=

# Safepay (Pakistan-based gateway used for deposits/invoice payments instead
# of Stripe, which doesn't onboard Pakistani merchants). Same variable names
# as the sibling YDEL project's .env.example — reuse the same sandbox
# SAFEPAY_API_KEY from there if you already have one, rather than creating a
# second sandbox account just for this app.
SAFEPAY_API_KEY=
# "sandbox" while testing, "production" once you have a live Safepay account.
SAFEPAY_ENVIRONMENT=sandbox
# PKR is the only currency verified to use whole-unit (not cents) amounts —
# see supabase/functions/_shared/safepay.ts. Test carefully before changing.
SAFEPAY_CURRENCY=PKR
# From Dashboard -> Developers -> Endpoints -> (your endpoint) -> shared secret,
# after you've created an endpoint pointing at the deployed safepay-webhook URL.
SAFEPAY_WEBHOOK_SECRET=

# Base URL of the deployed public-quote function, used to build the link that
# gets shared with clients, e.g. https://<project-ref>.supabase.co/functions/v1/public-quote
PUBLIC_QUOTE_BASE_URL=

# Shared secret the daily overdue-invoice cron job must send as the
# x-cron-secret header. Generate any random string.
CRON_SECRET=
